<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: typed text cannot leave the device. -->
    <!-- VIBRATE: key vibration. A normal permission, granted at install; no data access. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zenboard">

        <!-- Exported: the system opens it from keyboard settings (method.xml settingsActivity). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The launcher icon, off until "Show in app drawer" turns it on. Off in the manifest on
            purpose: Android 10+ puts an App info stand-in in the drawer for an app that requests
            permissions and switches off a launcher icon its manifest enables, so the only way to
            hide it completely is to start hidden. Settings open from the system keyboard settings.
        -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- BIND_INPUT_METHOD: only the system can bind to this service. -->
        <service
            android:name=".ZenboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
